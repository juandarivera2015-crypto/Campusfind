# Dependencies & builds
node_modules/
dist/
coverage/
__pycache__/
*.pyc
.venv/
venv/

# Local configuration & secrets — NEVER commit
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
k8s/overlays/local/secrets.env
docker-compose.override.yml
*.pem
*.key

# Runtime data
backend/uploads/*
!backend/uploads/.gitkeep
stats-service/test.sqlite3
legacy/uploads/*
!legacy/uploads/.gitkeep

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log

# Test reports
*-report.xml
ai-testing/generated/*
!ai-testing/generated/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
