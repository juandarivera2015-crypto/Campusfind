# ── CampusFind API ── copy to .env for local development (never commit .env)
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database (MySQL / MariaDB — the same one XAMPP uses works)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusfind
DB_USER=root
DB_PASSWORD=
# In Docker/Kubernetes prefer *_FILE variables pointing to mounted secrets:
# DB_PASSWORD_FILE=/run/secrets/db_password

# JWT / OAuth 2.1 — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ISSUER=campusfind-auth
JWT_AUDIENCE=campusfind-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# OAuth public client (the React SPA) and its allowed redirect URIs
OAUTH_CLIENT_ID=campusfind-web
OAUTH_REDIRECT_URIS=http://localhost:5173/callback,http://localhost:8080/callback

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
