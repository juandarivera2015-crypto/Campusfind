    {
      "name": "1. OAuth 2.1 (Authorization Code + PKCE)",
      "item": [
        {
          "name": "Authorize user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/authorize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "authorize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response_type\": \"code\",\n  \"client_id\": \"{{clientId}}\",\n  \"redirect_uri\": \"{{redirectUri}}\",\n  \"code_challenge\": \"{{codeChallenge}}\",\n  \"code_challenge_method\": \"S256\",\n  \"state\": \"{{state}}\",\n  \"scope\": \"profile objects:read objects:write messages:read messages:write\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// OAuth 2.1 PKCE (S256): generate code_verifier, code_challenge and state",
                  "const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';",
                  "const rand = (n) => Array.from({ length: n }, () => charset[Math.floor(Math.random() * charset.length)]).join('');",
                  "const verifier = rand(64);",
                  "const challenge = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.collectionVariables.set('codeVerifier', verifier);",
                  "pm.collectionVariables.set('codeChallenge', challenge);",
                  "pm.collectionVariables.set('state', rand(24));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + authorization code', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('state is echoed (CSRF protection)', () => pm.expect(b.state).to.eql(pm.collectionVariables.get('state')));",
                  "pm.collectionVariables.set('authCode', b.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token (authorization_code) user A",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{authCode}}"
                },
                {
                  "key": "code_verifier",
                  "value": "{{codeVerifier}}"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + bearer JWT', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token_type).to.eql('Bearer');",
                  "});",
                  "pm.test('no-store cache header', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('refresh token is NOT in the body (HttpOnly cookie)', () => pm.expect(pm.response.json()).to.not.have.property('refresh_token'));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().access_token);",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
                  "if (pm.cookies.has('cf_csrf')) pm.collectionVariables.set('csrf', pm.cookies.get('cf_csrf'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
